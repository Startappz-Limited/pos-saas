{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-destructive-db.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for destructive DB commands..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pint-edited-file.sh\"",
            "timeout": 60,
            "statusMessage": "Formatting with Pint..."
          }
        ]
      }
    ]
  }
}
