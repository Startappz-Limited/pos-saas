# Bridge HTTP server
PORT=3025
BIND_HOST=127.0.0.1

# Must match BAILEYS_BRIDGE_TOKEN in the Laravel .env
BRIDGE_TOKEN=

# Where Laravel listens for webhooks. Must be reachable from this process.
# Example for Herd: http://fitness-center.test/api/webhooks/baileys
LARAVEL_WEBHOOK_URL=http://fitness-center.test/api/webhooks/baileys

# Must match BAILEYS_WEBHOOK_SECRET in the Laravel .env (HMAC-SHA256 of raw body)
LARAVEL_WEBHOOK_SECRET=

# Where to persist auth credentials per session. One subfolder per session_key.
SESSIONS_DIR=./sessions

# pino log level: trace | debug | info | warn | error | fatal | silent
# Keep this at info/warn in production — debug logs full message payloads and
# will fill the disk on its own if the process log is not rotated.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Ingestion policy — which inbound chats reach Laravel at all.
# Status/newsletter/broadcast default to OFF: every contact's daily status
# photo and video would otherwise be downloaded and stored forever. This is the
# main defence against runaway disk usage.
# ---------------------------------------------------------------------------
INGEST_STATUS=false
INGEST_NEWSLETTERS=false
INGEST_BROADCASTS=false
INGEST_GROUPS=true

# ---------------------------------------------------------------------------
# Media policy — messages that fail these checks are still recorded in the
# inbox, only the bytes are skipped.
# ---------------------------------------------------------------------------

# Never download media bigger than this (bytes). Default 5MB.
MEDIA_MAX_BYTES=5242880

# Message types whose bytes are downloaded. Add `video`/`sticker` at your own
# risk — video is by far the biggest disk consumer.
MEDIA_DOWNLOAD_TYPES=image,audio,document

# Download media posted inside group chats.
MEDIA_FROM_GROUPS=false
