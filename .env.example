APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

CURRENCY_CODE=KES
CURRENCY_SYMBOL=KSh

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fitness_center
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Baileys (unofficial WhatsApp) through Chatway Gateway. The key and webhook
# secret come from the gateway operator; the gateway POSTs events to
# https://<this app>/wa-gateway/webhook.
WA_GATEWAY_URL=https://wa.startappz.co.ke
WA_GATEWAY_TOKEN=
WA_GATEWAY_WEBHOOK_SECRET=
BAILEYS_QUEUE=baileys
BAILEYS_NOTIFY_ON_SALE=true
BAILEYS_NOTIFY_ON_ECOMMERCE_ORDER=true
BAILEYS_STATUS_MAX_RECIPIENTS=256

# Audit trail lives on its own SQLite connection (see config/database.php).
# Leave blank to use database/audit.sqlite.
AUDIT_DB_DATABASE=

# Customer credit — see config/credit.php. A credit sale for a wholesale
# customer with no credit account auto-creates one on these terms, unless the
# customer already has a credit_limit set or the shop overrides them in
# settings.credit. Limits are warn-only at the till by default: a sale that has
# been rung up must always reach the ledger.
CREDIT_DEFAULT_LIMIT=0
CREDIT_DEFAULT_PAYMENT_TERMS_DAYS=30
CREDIT_DEFAULT_GRACE_PERIOD_DAYS=7
CREDIT_ENFORCE_LIMIT_AT_POS=false

# API rate limits (requests per minute) — see config/ratelimit.php
RATE_LIMIT_API=120
RATE_LIMIT_AUTH=5
RATE_LIMIT_WEBHOOKS=300
RATE_LIMIT_WRITES=30
RATE_LIMIT_DESTRUCTIVE=10

# Security baseline — see config/security.php
SECURITY_FORCE_HTTPS=false
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
# Set false if the production host has no outbound egress to api.pwnedpasswords.com
SECURITY_PASSWORD_UNCOMPROMISED=true

# AI content generation — see config/ai.php. Shops may override the provider via
# Shop.settings.ai.provider; a provider with no key logs a warning and returns
# deterministic template content rather than failing the campaign.
AI_DRIVER=qwen
AI_DEFAULT_TONE="enthusiastic and friendly"
AI_DEFAULT_LANGUAGE=English

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT=30

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT=30
# Caps reasoning + answer tokens together; keep well above the caption size.
ANTHROPIC_MAX_TOKENS=16000

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=30

# Local checkout of the Flutter POS client, for `php artisan mobile:contract-diff`.
# Developer machines only — leave blank in production.
MOBILE_APP_PATH=/Users/startappzlimited/Documents/Development/Flutter/pos

# --- VAT (Kenya) -------------------------------------------------------------
# The engine only charges VAT for shops flagged `vat_registered`, so these are
# defaults, not switches: turning a shop on is done in Shops → Tax & Compliance.
TAX_ENABLED=true
TAX_COUNTRY=KE
TAX_AUTHORITY=KRA
TAX_LABEL=VAT
TAX_RATE_STANDARD=16
TAX_RATE_REDUCED=8
# Kenyan retail quotes VAT-inclusive shelf prices; set false for net/B2B pricing.
TAX_PRICES_INCLUDE_TAX=true
TAX_DEFAULT_CLASS=standard
# Whether delivery/packaging/other charges recharged to the customer carry VAT.
# Off by default because switching it on changes what customers are billed.
TAX_FEES_TAXABLE=false
TAX_FEES_TAX_CLASS=standard

# --- Invoice numbering -------------------------------------------------------
# Invoices are drawn from a gapless per-shop sequence: INV-NRB-2026-000123.
INVOICE_PREFIX=INV
INVOICE_RESET=yearly
INVOICE_PAD=6
INVOICE_SEPARATOR=-
INVOICE_INCLUDE_SHOP_CODE=true
