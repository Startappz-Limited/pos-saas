<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <!-- Re-records the flat API contract fixtures; run it on purpose by
                 naming this group (see tests/Feature/FlatApiContractTest.php). -->
            <group>api-contract-record</group>
            <!-- Re-records the /api/v1 contract fixtures (tests/Feature/ApiV1ContractTest.php). -->
            <group>api-v1-contract-record</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The suite's memory use grows across the run (each test boots the app);
             128M is no longer enough to reach the end. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <!-- Tests never inherit the developer's .env for these: URLs are plain
             http, and messaging channels start unconfigured; a test that needs a
             channel configures it (configureWhatsApp() in tests/Pest.php). -->
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="WHATSAPP_API_URL" value="" force="true"/>
        <env name="WHATSAPP_API_TOKEN" value="" force="true"/>
        <env name="WHATSAPP_PHONE_NUMBER_ID" value="" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="SECURITY_SIGNUP_CHECK_DNS" value="false" force="true"/>
        <env name="SECURITY_SIGNUP_BREACH_CHECK" value="false" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql_testing" force="true"/>
        <env name="DB_TEST_DATABASE" value="pos_saas_testing" force="true"/>
        <!-- Keep the audit trail off the real audit.sqlite file during tests. -->
        <env name="AUDIT_DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
